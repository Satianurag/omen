# Copy to .env (git-ignored) and fill in.
# omen loads `.env` only (not `.env.txt`). Prefer:  cp .env.example .env
# On Windows PowerShell:  Copy-Item .env.example .env

# SigNoz (deploy with Foundry — see docs/SIGNOZ_SETUP.md)
#   foundryctl cast -f casting.yaml
OMEN_SIGNOZ_URL=http://localhost:8080
# Service-account key only — no inline comments on this line (breaks auth)
OMEN_SIGNOZ_API_KEY=

# Optional: HTTP MCP bridge instead of Docker stdio
# OMEN_SIGNOZ_MCP_TRANSPORT=http
# OMEN_SIGNOZ_MCP_ENDPOINT=http://localhost:8000/mcp

# OpenTelemetry — demo apps and omen self-tracing (official opentelemetry-instrument)
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_EXPORTER_OTLP_PROTOCOL=grpc
OTEL_TRACES_EXPORTER=otlp
OTEL_METRICS_EXPORTER=none
OTEL_LOGS_EXPORTER=none
# Seconds to wait after k6 so OTLP traces land in SigNoz before correlate
# OMEN_SIGNOZ_FLUSH_SEC=5

# k6 MCP server
# Default: local k6 2.0+ (works on Windows, macOS, and Linux). Install k6, then:
#   uv run omen warm-k6
OMEN_K6_CMD=k6 x mcp
K6_NO_THRESHOLDS=true
# Linux-only alternative: Docker with --network host can reach 127.0.0.1 demo apps.
# Do NOT enable on Windows — Docker host networking cannot reach host-loopback demos.
# OMEN_K6_DOCKER=1
# OMEN_K6_IMAGE=grafana/mcp-k6:latest

# Model backend (gemini | ollama | anthropic | claude_agent)
OMEN_LLM=gemini
OMEN_MODEL=gemini-3.1-flash-lite
GEMINI_API_KEY=
# Independent groundedness screen (uses same Gemini model when OMEN_LLM=gemini)
OMEN_GUARDIAN=1
# OMEN_LLM=ollama
# OMEN_MODEL=granite4.1:8b
# OLLAMA_HOST=http://localhost:11434
# OMEN_LLM=anthropic
# OMEN_MODEL=claude-haiku-4-5
# ANTHROPIC_API_KEY=

# Optional: HMAC key for tamper-evident ledger (`omen verify` reports HMAC-keyed)
# Generate:  python -c "import secrets; print(secrets.token_hex(32))"
# THEODOSIA_LEDGER_KEY=
