# Copy to .env (git-ignored) and fill in. omen loads .env on `omen serve`.

# SigNoz (deploy with Foundry — see docs/SIGNOZ_SETUP.md)
#   foundryctl cast -f casting.yaml
OMEN_SIGNOZ_URL=http://localhost:8080
# Service-account key only — no inline comments on this line (breaks auth)
OMEN_SIGNOZ_API_KEY=

# Optional: HTTP MCP bridge instead of Docker stdio
# OMEN_SIGNOZ_MCP_TRANSPORT=http
# OMEN_SIGNOZ_MCP_ENDPOINT=http://localhost:8000/mcp

# OpenTelemetry — demo apps and omen self-tracing (official opentelemetry-instrument)
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_EXPORTER_OTLP_PROTOCOL=grpc
OTEL_TRACES_EXPORTER=otlp
OTEL_METRICS_EXPORTER=none
OTEL_LOGS_EXPORTER=none

# k6 MCP server (Linux: use Docker image; macOS/Windows: local k6 2.0+ with `k6 x mcp`)
OMEN_K6_DOCKER=1
K6_NO_THRESHOLDS=true
# OMEN_SIGNOZ_FLUSH_SEC=5

# Model backend (gemini | ollama | anthropic | claude_agent)
OMEN_LLM=gemini
OMEN_MODEL=gemini-3.1-flash-lite
GEMINI_API_KEY=
# Independent groundedness screen (uses same Gemini model when OMEN_LLM=gemini)
OMEN_GUARDIAN=1
# OMEN_LLM=ollama
# OMEN_MODEL=granite4.1:8b
# OLLAMA_HOST=http://localhost:11434
# OMEN_LLM=anthropic
# OMEN_MODEL=claude-haiku-4-5
# ANTHROPIC_API_KEY=
